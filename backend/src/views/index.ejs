<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<main>
    <!-- Seccion de Cajas -->
    <section id="cajas">
        <h2 class="h2-separador">Cajas</h2>

        <ul id="listado-cajas">
            <% productsArray.forEach(producto => { %>
                <% if (producto.categoria === "cajas") { %>
                    <li class="li-cajas">
                        <img class="img-producto" src="<%= producto.imagen %>" alt="<%= producto.nombre %>">

                        <h3 class="nombre-producto"><%= producto.nombre %></h3>

                        <p class="precio-producto">$<%= producto.precio %></p>

                        <p class="descripcion-producto">
                            <%= producto.descripcion %>
                        </p>

                        <p class="<%= producto.activo === 1 ? 'text-success' : 'text-danger' %>">
                            Estado: <%= producto.activo === 1 ? "Activo" : "Inactivo" %>
                        </p>

                    </li>
                <% } %>
            <% }) %>
        </ul>
    </section>

    <!-- Seccion de Skins -->
    <section id="skins">
        <h2 class="h2-separador">Skins</h2>

        <ul id="listado-skins">
            <% productsArray.forEach(producto => { %>
                <% if (producto.categoria === "skins") { %>
                    <li class="li-skins">
                        <img class="img-producto" src="<%= producto.imagen %>" alt="<%= producto.nombre %>">

                        <h3 class="nombre-producto"><%= producto.nombre %></h3>

                        <p class="precio-producto">$<%= producto.precio %></p>

                        <p class="descripcion-producto">
                            <%= producto.descripcion %>
                        </p>

                        <p class="<%= producto.activo === 1 ? 'text-success' : 'text-danger' %>">
                            Estado: <%= producto.activo === 1 ? "Activo" : "Inactivo" %>
                        </p>

                    </li>
                <% } %>
            <% }) %>
        </ul>
    </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
<script src="/js/index.js"></script>

<%- include("partials/footer.ejs") %>